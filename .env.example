# Copy to .env and change the values. Never commit .env.
# SQL Server password rules: 8+ chars, upper + lower case, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# JWT signing key, at least 32 characters. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET_KEY=change-this-to-a-long-random-string-32chars-min
