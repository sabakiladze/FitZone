@model SessionDetailsVm
@{ ViewData["Title"] = "Session"; }

<div class="mb-3"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> All sessions</a></div>

@if (Model.NeedsLogin)
{
    <div class="fz-panel p-4 text-center mx-auto" style="max-width:560px">
        <p class="mb-3">Please log in to see this session.</p>
        <a class="btn btn-light" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Login</a>
    </div>
    return;
}

@{
    var s = Model.Session;
    var past = Fmt.IsPast(s.StartsAt);
    var full = s.FreeSpots <= 0;
}

<section class="fz-panel p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="h3 mb-1">@Fmt.DateText(s.StartsAt)</h1>
            <div class="opacity-75">@Fmt.TimeRange(s.StartsAt, s.EndsAt)</div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2">
                <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil"></i> Edit</a>
                <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                      onsubmit="return confirm('Delete this session? Sessions that have bookings cannot be deleted.');">
                    <button class="btn btn-outline-light btn-sm"><i class="bi bi-trash"></i> Delete</button>
                </form>
            </div>
        }
    </div>
    <hr class="border-light opacity-25" />
    <dl class="fz-kv">
        <dt>Trainer</dt><dd><a asp-controller="Trainers" asp-action="Details" asp-route-id="@s.TrainerId">@s.TrainerName</a></dd>
        <dt>Starts</dt><dd>@Fmt.DateTimeText(s.StartsAt)</dd>
        <dt>Ends</dt><dd>@Fmt.DateTimeText(s.EndsAt)</dd>
        <dt>Capacity</dt><dd>@s.Capacity</dd>
        <dt>Free spots</dt><dd>@s.FreeSpots</dd>
        <dt>Status</dt><dd>@(past ? "Finished" : full ? "Full" : "Open for booking")</dd>
    </dl>

    @if (User.IsInRole("User"))
    {
        <div class="mt-4">
            @if (Model.MyBooking is not null)
            {
                <p class="mb-2"><i class="bi bi-check-circle"></i> You have booked this session.</p>
                @if (!past)
                {
                    <form asp-controller="Bookings" asp-action="Cancel" asp-route-id="@Model.MyBooking.Id" method="post"
                          onsubmit="return confirm('Cancel your booking?');">
                        <input type="hidden" name="returnTo" value="@Context.Request.Path" />
                        <button class="btn btn-outline-light">Cancel my booking</button>
                    </form>
                }
            }
            else if (past)
            {
                <p class="mb-0 opacity-75">This session has already started.</p>
            }
            else if (full)
            {
                <p class="mb-0 opacity-75">This session is full.</p>
            }
            else
            {
                <form asp-action="Book" asp-route-id="@s.Id" method="post">
                    <button class="btn btn-light btn-lg fw-semibold">Book this session</button>
                </form>
                <div class="small opacity-75 mt-2">An active membership is required.</div>
            }
        </div>
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        <p class="mt-4 mb-0"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in</a> to book this session.</p>
    }
</section>

@if (User.IsInRole("Admin"))
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h4 mb-0">Bookings for this session</h2>
        <a class="btn btn-outline-fz btn-sm" asp-controller="Bookings" asp-action="All" asp-route-sessionId="@s.Id">Open in bookings list</a>
    </div>
    @if (Model.Bookings.Count == 0)
    {
        <p class="text-muted">No bookings yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Booked at</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td>@Fmt.DateTimeText(b.BookedAt)</td>
                        <td><partial name="_StatusBadge" model="b.Status" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
