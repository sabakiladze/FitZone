@model PlanForm
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Edit plan" : "Add plan";
}
<div class="fz-panel fz-auth" style="max-width:560px">
    <h1 class="text-center mb-3">@ViewData["Title"]</h1>
    <partial name="_ValidationSummary" />
    <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="row g-2">
            <div class="col-sm-6 mb-3">
                <label asp-for="Price" class="form-label">Price @(string.IsNullOrEmpty(Fmt.Currency) ? "" : $"({Fmt.Currency})")</label>
                <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="DurationInDays" class="form-label"></label>
                <input asp-for="DurationInDays" type="number" min="1" max="365" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="VisitLimit" class="form-label"></label>
            <input asp-for="VisitLimit" type="number" min="1" class="form-control" placeholder="Leave empty for unlimited visits" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-light fw-semibold flex-fill">Save</button>
            <a class="btn btn-outline-light" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</div>
