@model ErrorVm
@{ ViewData["Title"] = "Something went wrong"; }
<div class="fz-panel p-4 text-center mx-auto" style="max-width:640px">
    <h1 class="h4"><i class="bi bi-exclamation-triangle"></i> Something went wrong</h1>
    <p class="mb-3">@Model.Message</p>
    <a class="btn btn-light" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
