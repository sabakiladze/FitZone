@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Home") · FitZone</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark fz-nav" aria-label="Main">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <span class="fz-logo"><i class="bi bi-lightning-charge-fill"></i></span> FitZone
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="nav" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item"><a class="nav-link @Active("Trainers")" asp-controller="Trainers" asp-action="Index">Trainers</a></li>
                <li class="nav-item"><a class="nav-link @Active("Sessions")" asp-controller="Sessions" asp-action="Index">Workout sessions</a></li>
                <li class="nav-item"><a class="nav-link @Active("Plans")" asp-controller="Plans" asp-action="Index">Memberships</a></li>

                @if (isAdmin)
                {
                    <li class="nav-item"><a class="nav-link @Active("Bookings")" asp-controller="Bookings" asp-action="All">All bookings</a></li>
                }
                else if (signedIn)
                {
                    <li class="nav-item"><a class="nav-link @Active("Membership")" asp-controller="Membership" asp-action="Index">My membership</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Bookings")" asp-controller="Bookings" asp-action="My">My bookings</a></li>
                }

                @if (signedIn)
                {
                    <li class="nav-item dropdown ms-lg-3">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @User.Identity!.Name
                            <span class="badge bg-light text-dark ms-1">@(isAdmin ? "Admin" : "User")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item ms-lg-3"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item ms-lg-1"><a class="btn btn-register" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container-fluid px-3 px-lg-4 py-4 py-lg-5 flex-grow-1">
    <div class="mx-auto" style="max-width:1280px">
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
    </div>
</main>

<footer class="fz-footer"><b>FitZone</b> &nbsp; Times are shown in @Fmt.ZoneName</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
