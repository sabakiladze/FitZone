@model BookingsListVm
@{ ViewData["Title"] = "My bookings"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">My bookings</h1>
    <a class="btn btn-fz" asp-controller="Sessions" asp-action="Index">Find a session</a>
</div>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">You have no bookings yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Session</th><th>Trainer</th><th>Status</th><th>Booked at</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in Model.Items)
            {
                var canCancel = b.Status is BookingStatus.Active or BookingStatus.Pending && !Fmt.IsPast(b.StartsAt);
                <tr>
                    <td>
                        <a asp-controller="Sessions" asp-action="Details" asp-route-id="@b.WorkoutSessionId">@Fmt.DateText(b.StartsAt)</a><br />
                        <span class="text-muted small">@Fmt.TimeRange(b.StartsAt, b.EndsAt)</span>
                    </td>
                    <td>@b.TrainerName</td>
                    <td><partial name="_StatusBadge" model="b.Status" /></td>
                    <td>@Fmt.DateTimeText(b.BookedAt)</td>
                    <td class="text-end">
                        @if (canCancel)
                        {
                            <form asp-action="Cancel" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Cancel this booking?');">
                                <button class="btn btn-outline-danger btn-sm">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
}
