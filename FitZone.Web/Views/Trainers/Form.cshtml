@model TrainerForm
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Edit trainer" : "Add trainer";
}
<div class="fz-panel fz-auth" style="max-width:560px">
    <h1 class="text-center mb-3">@ViewData["Title"]</h1>
    <partial name="_ValidationSummary" />
    <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Specialization" class="form-label"></label>
            <textarea asp-for="Specialization" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="ExperienceYears" class="form-label"></label>
            <input asp-for="ExperienceYears" type="number" min="0" max="60" class="form-control" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-light fw-semibold flex-fill">Save</button>
            <a class="btn btn-outline-light" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</div>
