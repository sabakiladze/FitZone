@model UserDetailsVm
@{
    var p = Model.Profile;
    ViewData["Title"] = $"{p.FirstName} {p.LastName}";
    var initials = string.Concat(new[] { p.FirstName, p.LastName }.Where(x => !string.IsNullOrEmpty(x)).Select(x => char.ToUpperInvariant(x[0])));
}

<p><a asp-action="Index"><i class="bi bi-arrow-left"></i> All users</a></p>

<section class="fz-panel fz-profile p-4 p-lg-5 mb-4">
    <div class="d-flex flex-wrap align-items-center gap-4">
        <div class="fz-avatar-lg">@initials</div>
        <div class="flex-grow-1">
            <h1 class="mb-1">@p.FirstName @p.LastName</h1>
            <div class="opacity-75">@@@p.UserName</div>
            <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="fz-chip"><i class="bi bi-envelope"></i> @p.Email</span>
                <span class="fz-chip"><i class="bi bi-shield-check"></i> @p.Role</span>
                <span class="fz-chip"><i class="bi bi-calendar-check"></i> Registered @Fmt.DateText(p.CreatedAt)</span>
            </div>
        </div>
        @if (Model.IsUser)
        {
            <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                  onsubmit="return confirm('Delete this user? Their personal data will be wiped and they can no longer log in. This cannot be undone.');">
                <button class="btn btn-outline-danger"><i class="bi bi-person-x"></i> Delete user</button>
            </form>
        }
    </div>

    @if (Model.IsUser)
    {
        <div class="row g-3 mt-3">
            <div class="col-6 col-lg-3"><div class="fz-stat"><div class="v">@(Model.Membership?.PlanName ?? "None")</div><div class="l">Active membership</div></div></div>
            <div class="col-6 col-lg-3"><div class="fz-stat"><div class="v">@(Model.Membership is null ? "-" : Model.Membership.RemainingVisits is null ? "Unlimited" : Model.Membership.RemainingVisits.ToString())</div><div class="l">Visits left</div></div></div>
            <div class="col-6 col-lg-3"><div class="fz-stat"><div class="v">@Model.Pager.TotalCount</div><div class="l">Bookings</div></div></div>
            <div class="col-6 col-lg-3"><div class="fz-stat"><div class="v">@Model.Visits.Count</div><div class="l">Gym visits</div></div></div>
        </div>
        @if (Model.Membership is not null)
        {
            <p class="mt-3 mb-0 small opacity-75">Valid until @Fmt.DateTimeText(Model.Membership.EndDate).</p>
        }
        else
        {
            <p class="mt-3 mb-0 small opacity-75">No active membership.</p>
        }
    }
</section>

@if (!Model.IsUser)
{
    <p class="text-muted">Admins have no bookings, visits or membership.</p>
    return;
}

<div class="fz-head"><div><h2 class="mb-0">Booking history</h2></div></div>

@if (Model.Bookings.Count == 0)
{
    <p class="text-muted">No bookings yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Session</th><th>Trainer</th><th>Status</th><th>Booked at</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Bookings)
            {
                <tr>
                    <td>
                        <a asp-controller="Sessions" asp-action="Details" asp-route-id="@b.WorkoutSessionId">@Fmt.DateText(b.StartsAt)</a><br />
                        <span class="text-muted small">@Fmt.TimeRange(b.StartsAt, b.EndsAt)</span>
                    </td>
                    <td>@b.TrainerName</td>
                    <td><partial name="_StatusBadge" model="b.Status" /></td>
                    <td>@Fmt.DateTimeText(b.BookedAt)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
}

<div class="fz-head mt-5"><div><h2 class="mb-0">Visit history</h2></div></div>

@if (Model.Visits.Count == 0)
{
    <p class="text-muted">No visits yet.</p>
}
else
{
    <p class="text-muted small">Changing the time must stay inside the membership period. Deleting a visit gives it back to the user if the plan has a visit limit and is still active.</p>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Checked in</th><th>Plan</th><th>New time (@Fmt.ZoneName)</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model.Visits)
            {
                var formId = "visit-" + v.Id;
                <tr>
                    <td>@Fmt.DateTimeText(v.CheckedInAt)</td>
                    <td>@v.PlanName</td>
                    <td>
                        <form id="@formId" asp-action="EditVisit" method="post" class="d-flex gap-2">
                            <input type="hidden" name="userId" value="@p.Id" />
                            <input type="hidden" name="visitId" value="@v.Id" />
                            <input name="checkedInAt" type="datetime-local" class="form-control form-control-sm" style="max-width:15rem"
                                   value="@Fmt.InputValue(Fmt.ToLocal(v.CheckedInAt))" required />
                            <button class="btn btn-outline-secondary btn-sm">Save</button>
                        </form>
                    </td>
                    <td class="text-end">
                        <form asp-action="DeleteVisit" method="post" onsubmit="return confirm('Delete this visit?');">
                            <input type="hidden" name="userId" value="@p.Id" />
                            <input type="hidden" name="visitId" value="@v.Id" />
                            <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
