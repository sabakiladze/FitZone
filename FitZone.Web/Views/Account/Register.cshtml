@model RegisterVm
@{ ViewData["Title"] = "Register"; }
<div class="fz-panel fz-auth">
    <h1 class="text-center mb-3">Register</h1>
    <partial name="_ValidationSummary" />
    <form asp-action="Register" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        </div>
        <div class="row g-2">
            <div class="col-sm-6 mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 8 characters: Latin letters only, one capital letter and one symbol (for example <code>Gym2026!</code>).</div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        </div>
        <button class="btn btn-light w-100 fw-semibold">Register</button>
    </form>
    <p class="text-center small mt-3 mb-0">
        Already registered? <a asp-action="Login">Login</a>
    </p>
</div>
